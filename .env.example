# ---- AI engine ----
# Leave LLM_PROVIDER empty for automatic selection:
#   ANTHROPIC_API_KEY set  -> "anthropic" (Claude API)
#   running on Vercel      -> "gateway"   (Claude via Vercel AI Gateway, no key needed)
#   otherwise              -> "ollama"    (local model: nothing leaves your network)
# LLM_PROVIDER=ollama

# Claude (anthropic / gateway)
# ANTHROPIC_API_KEY=
# AI_GATEWAY_API_KEY=        # only needed for the gateway outside Vercel
# CLAUDE_MODEL=claude-opus-5

# Local model (ollama)
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:14b
# OLLAMA_NUM_CTX=16384

# Max characters sent to the model per request (defaults: 400000 Claude, 24000 Ollama)
# LLM_CONTEXT_CHARS=
# Parallel model calls per agent
# AGENT_CONCURRENCY=3

# ---- Storage ----
# Local JSON files by default. When BLOB_READ_WRITE_TOKEN is set (Vercel Blob
# store connected to the project) a private Blob store is used instead.
# DATA_DIR=./data
# STORAGE_BACKEND=fs|blob

# ---- Access control (optional HTTP Basic auth for the whole site) ----
# APP_USERNAME=
# APP_PASSWORD=
