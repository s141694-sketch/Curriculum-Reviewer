# ---- AI engine ----
# "anthropic" = Claude API (best quality; document text is sent to Anthropic's API)
# "ollama"    = local model on your own server (nothing leaves your network)
LLM_PROVIDER=anthropic

# Claude (when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5

# Local model (when LLM_PROVIDER=ollama)
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:14b
# OLLAMA_NUM_CTX=16384

# Max characters sent to the model per request (defaults: 400000 Claude, 24000 Ollama)
# LLM_CONTEXT_CHARS=
# Parallel model calls per agent
# AGENT_CONCURRENCY=3

# ---- Storage ----
# Where reviews and standards frameworks are saved (JSON files)
# DATA_DIR=./data

# ---- Access control (optional HTTP Basic auth for the whole site) ----
# APP_USERNAME=
# APP_PASSWORD=
