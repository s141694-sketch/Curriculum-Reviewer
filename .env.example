# ---- الذكاء الاصطناعي ----
# open      = نموذج مفتوح المصدر عبر أي خادم متوافق مع OpenAI (الافتراضي)
# anthropic = Claude عبر واجهة Anthropic
AI_PROVIDER=open

# النموذج المفتوح: Ollama محليًا (ollama pull qwen2.5:14b) أو أي مزوّد مستضاف
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=qwen2.5:14b
AI_API_KEY=

# يُستخدم فقط عندما يكون AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# ---- الدخول والأدوار ----
# سر توقيع جلسة الدخول (غيّره في الإنتاج)
SESSION_SECRET=
# رموز الدخول للأدوار المرتفعة. الرموز المدمجة في src/lib/session.ts تعمل مباشرة؛
# اكتب هنا رموزًا أخرى إذا أردت استبدالها دون تعديل الكود.
REVIEWER_PASSCODE=
ADMIN_PASSCODE=
